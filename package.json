{
  "name": "@2bad/onvif-workspace",
  "private": true,
  "type": "module",
  "imports": {
    "#onvif/*": "./packages/onvif/source/*",
    "#onvif-discovery/*": "./packages/discovery/source/*",
    "#onvif-events/*": "./packages/events/source/*",
    "#onvif-management/*": "./packages/management/source/*",
    "#onvif-media/*": "./packages/media/source/*",
    "#tools/*": "./tools/*"
  },
  "scripts": {
    "bench": "vitest bench --run --reporter=verbose",
    "bench:memory": "node --expose-gc --import tsx tools/bench/memory.ts",
    "bench:regression": "tsx tools/bench/regression.ts",
    "build": "pnpm --recursive --filter './packages/*' run build",
    "check": "run-p check:**",
    "check:code": "oxlint ./packages ./tools",
    "check:codegen": "tsx tools/codegen/index.ts --check",
    "check:format": "oxfmt --check ./packages ./tools",
    "check:size": "tsx tools/bench/size.ts",
    "check:types": "tsc --noEmit",
    "codegen": "tsx tools/codegen/index.ts",
    "codegen:specs": "tsx tools/codegen/fetch-specs.ts",
    "fix": "run-p fix:**",
    "fix:code": "oxlint --fix ./packages ./tools",
    "fix:format": "oxfmt ./packages ./tools",
    "fixtures:capture": "tsx --env-file=.env tools/fixtures/capture.ts",
    "fixtures:import": "tsx tools/fixtures/import.ts",
    "test": "vitest run",
    "test:fuzz": "vitest run fuzz",
    "test:integration": "vitest run integration --coverage",
    "test:unit": "vitest run unit --coverage"
  },
  "devDependencies": {
    "@2bad/axiom": "2.1.0",
    "@2bad/tsconfig": "4.0.0",
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "fast-check": "4.10.2",
    "fast-xml-parser": "5.11.2",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "publint": "0.3.25",
    "tsdown": "0.23.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.8.2",
  "engines": {
    "node": ">=26"
  },
  "volta": {
    "node": "26.10.0",
    "pnpm": "12.8.2"
  }
}
