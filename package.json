{
  "name": "@2bad/onvif",
  "version": "1.0.0-beta.6",
  "description": "",
  "keywords": [
    "onvif"
  ],
  "homepage": "https://github.com/2BAD/onvif#readme",
  "bugs": {
    "url": "https://github.com/2BAD/onvif/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2BAD/onvif.git"
  },
  "license": "MIT",
  "author": "2BAD (https://github.com/2BAD)",
  "contributors": [
    {
      "name": "Jason Hyde",
      "email": "github@2bad.me",
      "url": "https://github.com/mrhyde"
    }
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      }
    }
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "run-p check:**",
    "check:code": "oxlint ./source",
    "check:format": "oxfmt --check ./source",
    "check:types": "tsc --noEmit",
    "fix": "run-p fix:**",
    "fix:code": "oxlint --fix ./source",
    "fix:format": "oxfmt ./source",
    "prepublishOnly": "run-s build",
    "preversion": "run-s check test build",
    "test": "vitest run",
    "test:integration": "vitest run integration --coverage",
    "test:unit": "vitest run unit --coverage"
  },
  "dependencies": {
    "fast-xml-parser": "5.10.1"
  },
  "devDependencies": {
    "@2bad/axiom": "2.1.0",
    "@2bad/tsconfig": "4.0.0",
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "publint": "0.3.23",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=26"
  },
  "volta": {
    "node": "26.7.0",
    "pnpm": "11.20.0"
  }
}
