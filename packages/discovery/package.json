        "default": "./build/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@2bad/onvif": "workspace:^"
  },
  "peerDependencies": {
    "@2bad/onvif": "workspace:^"
  },
  "engines": {
    "node": ">=26"
  }
