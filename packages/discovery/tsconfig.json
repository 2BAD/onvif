{
  "extends": "@2bad/tsconfig",
  "include": ["source/**/*"],
  "exclude": ["source/**/*.test.ts"],
  "compilerOptions": {
    "target": "es2025",
    "lib": ["es2025", "esnext.error", "esnext.typedarrays"],
    "outDir": "build",
    "types": ["node"],
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true
  }
}
