{
  "extends": "@2bad/tsconfig",
  "include": ["packages/*/source/**/*", "packages/*/tsdown.config.ts", "tools/**/*", "vitest.config.ts"],
  "compilerOptions": {
    "target": "es2025",
    "lib": ["es2025", "esnext.array", "esnext.error", "esnext.typedarrays"],
    "noEmit": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@2bad/onvif": ["./packages/onvif/source/index.ts"],
      "@2bad/onvif/soap": ["./packages/onvif/source/soap/index.ts"]
    }
  }
}
